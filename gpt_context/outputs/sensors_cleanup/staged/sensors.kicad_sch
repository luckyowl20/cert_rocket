	)
	(text "SENSOR DESIGN NOTES\n3.3V, 4-wire SPI; keep all CS high at startup.\nR9-R11: 10k 1% (0.33mA when selected).\nPlace bypass capacitors at each supply pin.\nU10: mode 1, Qvar/analog hub disabled.\nC24 follows ADI tantalum recommendation.\nDigiKey: TAJA105K016RNJ (478-1649-1-ND)\nhttps://www.digikey.com/en/products/detail/kyocera-avx/TAJA105K016RNJ/563757" (exclude_from_sim no) (at 177.038 105.41 0) (effects (font (size 1.27 1.27) (thickness 0.254)) (justify left)) (uuid "d69b7c0d-4e47-45cd-a99b-db717da6e990"))

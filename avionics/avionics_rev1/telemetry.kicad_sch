		(uuid "4cc11c2c-a891-47c2-8586-f9526855d898")
	)
	(text "NRST: active-low radio reset. BUSY low: ready for SPI command.\nRF_SW HIGH enables RX. Internal DIO2 HIGH selects TX.\nUse module DC-DC mode and configure DIO3 for the TCXO.\nDIO1 is the configurable interrupt. Verify RX/TX control in firmware."
		(exclude_from_sim no)
		(at 23.368 133.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)

	(text "Individual Pyro Channel Power Control"
		(exclude_from_sim no)
		(at 20.32 21.59 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "284725db-9832-41f9-9ac6-bca03727bfbb")
	)
	(text "SENSE DESIGN NOTES\n100k / 18k dividers: 16.8 V -> 2.563 V nominal; 2.607 V at +/-1% worst-case ratio.\nU15 and U7 use the MCU 3.3 V rail and common SENSE_EN; R44 holds enable low at reset.\nTMUX1511 powered-off isolation is specified only for signals <=3.6 V; no transient clamp is implied.\n10 nF caps at ADC pins; pyro RC ~153 us. Wait >=5 ms after enable and use long ADC acquisition.\nSense reads the switched FET drain; this alone is not an independent arming interlock.\n"
		(exclude_from_sim no)
		(at 124.206 127.508 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "cd18ad90-e710-493e-b3c0-f50829a638a8")
	)
	(text "Pyro sense: powered-off isolation and ADC filtering"
		(exclude_from_sim no)
		(at 20.32 119.38 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "dee7f66c-0ece-4b3f-8832-7f5a02ccd56d")
	)
	(text "Pyro power good will be determined by MCU\nbefore fire command is sent"
		(exclude_from_sim no)
		(at 23.368 40.132 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ed01210e-e75c-42ac-8957-0fe57f934495")
	)
	(text "TODO: \noverall design review\nassign footprints for and gate, connector, fets\ndetermine resistor values for FETs dividers\npick correct FET footprint / part #\npick a connector footprint for J3 (small screw terminal) \n"
		(exclude_from_sim no)
		(at 297.942 65.786 0)
		(effects
